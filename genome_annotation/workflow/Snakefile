import os
import glob
from pathlib import Path
from snakemake.utils import min_version
min_version("8.11.3")

configfile: "config/config.yaml"

# Define the samples
SAMPLES = glob_wildcards(config["rna_reads_directory"]+"/{sample}_{group}.fastq.gz")
ASSEMBLY_BASE = Path(config["genome_assembly"]).stem

RUN_ID = config["Run ID"]

def get_final_output():
    final_output = expand(
        "results/{run_id}/braker/braker.gtf", run_id=RUN_ID
    )
    final_output.append(expand("results/{run_id}/braker/braker.aa", run_id=RUN_ID))
    return final_output

rule all:
    input:
        get_final_output()

include:    "rules/repeatmasker.smk"

if config["rna_reads_directory"]:
    include:    "rules/BRAKER3.smk"
elif config["SRA_accession"]:
    include:    "rules/BRAKER3_SRA.smk"





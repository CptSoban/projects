    output:
        
     run:
        counts_df = pd.read_csv(input.counts, sep= "\t", header=0)
        #Moves Geneid column to index
        #counts_df = pd.read_csv(input.counts, sep= "\t", header=0, index_col=0)
        counts_df = counts_df.drop(["Chr","Start","End","Strand","Length"])

        for col_name in counts_df.columns:
            new_col_name = Path(col_name).stem.removesuffix(".sortedByCoord.out")

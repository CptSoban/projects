from snakemake.utils import min_version
# Check if the version of snakemake is at least 8.11.3
min_version("8.11.3")
from collections import defaultdict

# Load the configuration file
configfile: "config/config.yaml"

# Define the samples
SAMPLES = glob_wildcards(config["reads_dir"]+"/{barcode}/{sample}.fastq.gz")
RUN_ID = config["run_id"]

# Dictionary to store samples per barcode
# This will be used to concatenate reads from the same barcode
samples_per_barcode = defaultdict(list)
for bc, smp in zip(SAMPLES.barcode, SAMPLES.sample):
    samples_per_barcode[bc].append(smp)


# Define the final output files
def get_final_output():
    # Check if samples are detected
    if not SAMPLES:
        raise ValueError("No samples detected. Check 'reads_dir' in config file.")
    
    final_output = [
        # Add chimera filtered fastq files to final output
        expand("results/{run_id}/chimera_filtering/{barcode}_nochim.fastq.gz",
               run_id=RUN_ID, barcode=SAMPLES.barcode),]

    final_output.extend([
        # Add classification files to final output
        expand("results/{run_id}/emu/{barcode}_rel-abundance.tsv",
                run_id=RUN_ID,barcode=SAMPLES.barcode),
    ])
      
    return final_output

# Define the rule to generate the final output
rule all:
    input:
        get_final_output()

# Include the rules for the workflow
include:    "rules/concat.smk"

if config["chimera_removal"] == "ref":
    include:    "rules/chimera_filtering_ref.smk"
elif config["chimera_removal"] == "denovo":
    include:    "rules/chimera_filtering_denovo.smk"
else:
    raise ValueError("Invalid value for 'chimera_removal' in config file. Choose 'ref' or 'denovo'.")

include:    "rules/classification.smk"






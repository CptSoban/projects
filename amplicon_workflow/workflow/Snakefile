from snakemake.utils import min_version
from snakemake.io import glob_wildcards
import os

# Require minimum Snakemake version
min_version("8.11.3")

# Load config
configfile: "config/config.yaml"

# Global variables
RUN_ID = config["run_id"]


############################################################
# CHECKPOINT-BASED BARCODE DISCOVERY
############################################################

def get_barcodes():
    """
    Discover barcode names after demultiplex checkpoint finishes.
    Example output:
        ["barcode01", "barcode02", ...]
    """
    ckpt = checkpoints.demultiplex.get()

    demux_dir = ckpt.output.output_dir

    return glob_wildcards(
        os.path.join(demux_dir, "{barcode}.fastq.gz")
    ).barcode


def demux_filename(wildcards):
    """
    Return full paths to demultiplexed FASTQ files.
    """
    ckpt = checkpoints.demultiplex.get()

    demux_dir = ckpt.output.output_dir
    barcodes = get_barcodes()

    return os.path.join(demux_dir, f"{wildcards.barcode}.fastq.gz")

############################################################
# FINAL TARGETS
############################################################

def get_final_output(wildcards):
    """
    Dynamic final outputs depending on discovered barcodes.
    """
    barcodes = get_barcodes()

    return (
            # expand(
            #     "results/{run_id}/filtering/{barcode}_trim.fastq",
            #     run_id=RUN_ID,
            #     barcode=barcodes
            # )
            # +
            #  expand(
            #     "results/{run_id}/filtering/{barcode}_filt.fastq.gz",
            #     run_id=RUN_ID,
            #     barcode=barcodes
            # )
        expand(
            "results/{run_id}/clustering/{barcode}_centroids.fasta",
            run_id=RUN_ID,
            barcode=barcodes
        )
        +
        expand(
            "results/{run_id}/chimera_filtering/{barcode}_nochim.fasta",
            run_id=RUN_ID,
            barcode=barcodes
        )
        +
        [
            f"results/{RUN_ID}/emu/emu-combined-{config['taxonomic_rank']}.tsv"
        ]
    )


rule all:
    input:
        get_final_output


############################################################
# INCLUDE WORKFLOW MODULES
############################################################

include: "rules/01_simplex_basecalling.smk"
include: "rules/02_general_filtering.smk"
include: "rules/03_dereplication.smk"
include: "rules/04_clustering.smk"
include: "rules/05_chimera_filtering_denovo.smk"
include: "rules/06_fa2fq.smk"
include: "rules/07_classification.smk"


